#!/bin/bash
#SBATCH --job-name=mma_extract_ac
#SBATCH --output=logs/extract_ac_%j.out
#SBATCH --error=logs/extract_ac_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --partition=scavenge
#SBATCH --gres=gpu:2
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

# Pre-extract CLAP audio + CLIP-text caption embeddings for AudioCaps,
# producing the memmap consumed by ExtractedAudioCaps in the xdataset_fgw
# training run.
#
# Submit per split:
#   sbatch jobs/extract_audiocaps_features.job train
#   sbatch jobs/extract_audiocaps_features.job val
#   sbatch jobs/extract_audiocaps_features.job test

set -e
set -x

SPLIT="${1:-train}"

PROJECT_DIR="$HOME/MMA/MMAudio"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load CUDA/12.1.1
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:${PYTHONPATH}}"

mkdir -p logs data/audiocaps/extracted

python "$PROJECT_DIR/src/training/extract_audiocaps_features.py" \
    --audio_dir       "./data/audiocaps/audio" \
    --captions_tsv    "./data/audiocaps/audiocaps-${SPLIT}.tsv" \
    --output_dir      "./data/audiocaps/extracted/${SPLIT}" \
    --vae_ckpt        "ext_weights/v1-16.pth" \
    --vocoder_ckpt    "ext_weights/best_netG.pt" \
    --synchformer_ckpt "ext_weights/synchformer_state_dict.pth" \
    --clap_ckpt       "${CLAP_CKPT:-ext_weights/laion_clap.pt}" \
    --mode            16k \
    --audio_batch     16 \
    --text_batch      64

echo "Done extracting AudioCaps features for split=${SPLIT}"
