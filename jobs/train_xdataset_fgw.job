#!/bin/bash
#SBATCH --job-name=mma_xdataset_fgw
#SBATCH --output=logs/gw_xdataset_%j.out
#SBATCH --error=logs/gw_xdataset_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --partition=acltr
#SBATCH --gres=gpu:2
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

# Reading-B cross-dataset FGW: V from VGGSound, A from AudioCaps, cross-cost
# from CLIP-text caption cosine. Single run (no array — all variants merge
# into this one).
#
# Prerequisites:
#   1. AudioCaps download complete (jobs/download_audiocaps.job).
#   2. AudioCaps features extracted:
#        sbatch jobs/extract_audiocaps_features.job train
#      → produces data/audiocaps/extracted/train/{meta.memmap,ids.tsv}
#   3. MMAudio.__init__ has `self.clap_proj = nn.Linear(512, hidden_dim)`
#      (same head as the CLAP ablation; reused by xdataset_fgw).
#
# Submit:
#   sbatch jobs/train_xdataset_fgw.job
# Override λ:
#   sbatch --export=ALL,LAMBDA=1e-3 jobs/train_xdataset_fgw.job

set -e
set -x

PROJECT_DIR="$HOME/MMA/MMAudio"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load CUDA/12.1.1
module load NCCL/2.18.3-GCCcore-12.3.0-CUDA-12.1.1
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:${PYTHONPATH}}"
export TORCH_DEVICE_BACKEND_AUTOLOAD=0

echo "Pre-warming torch import cache..."
time python -c "import torch; print('torch', torch.__version__)"
echo "Cache warm."

mkdir -p logs output

MODEL="${MODEL:-small_16k}"
ITERS="${ITERS:-300000}"
LAMBDA="${LAMBDA:-5e-3}"
BATCH_SIZE="${BATCH_SIZE:-32}"
EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-${BATCH_SIZE}}"
COMPILE="${COMPILE:-False}"
COLLAPSE_PENALTY="${COLLAPSE_PENALTY:-vicreg}"
M_AUDIOCAPS="${M_AUDIOCAPS:-32}"

OMP_NUM_THREADS=4 torchrun --standalone --nproc_per_node=2 "$PROJECT_DIR/src/train.py" \
    exp_id="gw_xdataset_fgw" \
    model="$MODEL" \
    num_iterations="$ITERS" \
    batch_size="$BATCH_SIZE" \
    eval_batch_size="$EVAL_BATCH_SIZE" \
    compile="$COMPILE" \
    gw_regularization.enabled=true \
    gw_regularization.variant=xdataset_fgw \
    gw_regularization.lambda_gw="$LAMBDA" \
    gw_regularization.detach_video=true \
    gw_regularization.collapse_penalty="$COLLAPSE_PENALTY" \
    gw_regularization.xdataset_audiocaps_subsample="$M_AUDIOCAPS"

echo "Done: gw_xdataset_fgw"
