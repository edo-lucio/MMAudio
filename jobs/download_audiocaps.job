#!/bin/bash
#SBATCH --job-name=mma_dl_audiocaps
#SBATCH --output=logs/dl_audiocaps_%j.out
#SBATCH --error=logs/dl_audiocaps_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=12:00:00
#SBATCH --partition=acltr
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL,END

# Download a size-capped subset of AudioCaps (Kim et al. 2019, NAACL).
# AudioCaps is the manually-captioned audio-text dataset MMAudio uses to
# expand the audio-text training pool beyond VGGSound. This thesis does
# not currently use audio-text-only joint training (text was dropped); we
# fetch AudioCaps so the data is on hand if the next iteration of the
# experiment wants to bring text back.
#
# Output:  data/audiocaps/audio/{youtube_id}_{start:06d}.wav
#          data/audiocaps/audiocaps-{train,val,test}.tsv  (extractor-ready)
#
# Tunable constants (cap, per-split quotas, cookies path) live at the top
# of src/download_audiocaps.py.

set -e
set -x

PROJECT_DIR="$HOME/MMA/MMAudio"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:${PYTHONPATH}}"

mkdir -p logs data/audiocaps/audio

# ffmpeg + yt-dlp must be on PATH. They usually come with the conda env;
# if not, `mamba install -n gwot ffmpeg yt-dlp` once.
which yt-dlp || (echo "yt-dlp missing"; exit 2)
which ffmpeg || (echo "ffmpeg missing"; exit 2)

python "$PROJECT_DIR/src/download_audiocaps.py"

echo "Done. Tail of train manifest:"
tail -5 data/audiocaps/audiocaps-train.tsv 2>/dev/null || true
