#!/bin/bash
#SBATCH --job-name=mma_gw_clap
#SBATCH --output=logs/gw_clap_%A_%a.out
#SBATCH --error=logs/gw_clap_%A_%a.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --partition=acltr
#SBATCH --gres=gpu:2
#SBATCH --array=0-3
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL,ARRAY_TASKS

# Ablation: replace the VAE-latent audio side of the GW regulariser with
# precomputed LAION-CLAP audio embeddings. Hypothesis: CLAP's text-aware
# audio space shares structure with CLIP's text-aware video space, so the
# GW alignment should be easier to satisfy than aligning VAE-latent
# audio geometry to CLIP video geometry.
#
# Each array task = 1 batch-level variant on 2 GPUs.
#   0 -> global   1 -> projected   2 -> c_g   3 -> fused
# (got_token is excluded: its per-sample token-graph formulation does not
#  combine with sample-level CLAP embeddings without redesign.)
#
# Prerequisites: this job will FAIL until the following are in place.
#   1. src/training/extract_clap_features.py has been run on every
#      training split, producing clap_features.memmap + clap_features.tsv.
#   2. The dataloader (mmaudio.data_mod.extracted_vgg /
#      mmaudio.data_mod.extracted_audio) loads those memmaps and yields
#      a 'clap_features' field per sample.
#   3. mmaudio.model.networks.MMAudio gates a learnable
#      self.clap_proj = nn.Linear(512, hidden_dim) on
#      cfg.gw_regularization.audio_encoder == 'clap'.
#   4. mmaudio.runner.train_pass passes data['clap_features'] into
#      compute_gw_regularization(..., clap_f_raw=...).
#
# Submit:  sbatch jobs/train_clap_ablation.job
# Override variant:  sbatch --array=2 jobs/train_clap_ablation.job   # c_g only
# Override lambda:   sbatch --export=ALL,LAMBDA=1e-3 jobs/train_clap_ablation.job

set -e
set -x

PROJECT_DIR="$HOME/MMA/MMAudio"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"
CONDA_BIN="/opt/itu/easybuild/software/Miniconda3/25.5.1-1/bin/conda"

module load CUDA/12.1.1
module load NCCL/2.18.3-GCCcore-12.3.0-CUDA-12.1.1
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:${PYTHONPATH}}"

export TORCH_DEVICE_BACKEND_AUTOLOAD=0
echo "Pre-warming torch import cache..."
time python -c "import torch; print('torch', torch.__version__)"
echo "Cache warm."

mkdir -p logs output

VARIANTS=(global projected c_g fused)
VAR="${VARIANTS[$SLURM_ARRAY_TASK_ID]}"

MODEL="${MODEL:-small_16k}"
ITERS="${ITERS:-300000}"
# Inherit the v2 calibration: barrier dominates GW gain by ~800x.
LAMBDA="${LAMBDA:-5e-3}"
BATCH_SIZE="${BATCH_SIZE:-32}"
EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-${BATCH_SIZE}}"
COMPILE="${COMPILE:-False}"

AC_WEIGHT="${AC_WEIGHT:-1e-1}"
AC_ETA="${AC_ETA:-1e-4}"
case "$VAR" in
    global) AC_W=0.0 ;;
    projected|c_g|fused) AC_W="$AC_WEIGHT" ;;
    *) AC_W=0.0 ;;
esac

OMP_NUM_THREADS=4 torchrun --standalone --nproc_per_node=2 "$PROJECT_DIR/src/train.py" \
    exp_id="gw_clap_${VAR}" \
    model="$MODEL" \
    num_iterations="$ITERS" \
    batch_size="$BATCH_SIZE" \
    eval_batch_size="$EVAL_BATCH_SIZE" \
    compile="$COMPILE" \
    gw_regularization.enabled=true \
    gw_regularization.variant="$VAR" \
    gw_regularization.lambda_gw="$LAMBDA" \
    gw_regularization.detach_video=true \
    gw_regularization.anticollapse_weight="$AC_W" \
    gw_regularization.anticollapse_eta="$AC_ETA" \
    gw_regularization.audio_encoder=clap

echo "Done: gw_clap_${VAR}"
